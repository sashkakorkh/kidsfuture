                    <Box sx={{ marginRight: { md: '17px', xl: '0' } }}>\r\n                      <ContainedButton\r\n                        btnName=\"btnContainedWhite\"\r\n                        text=\"Долучитися\"\r\n                      />\r\n                    </Box>\r\n                  </Box>\r\n                </Box>\r\n              </Box>\r\n              <Box\r\n                sx={{\r\n                  justifySelf: { xs: 'center', md: 'flex-start' },\r\n                  position: 'relative',\r\n                  '::before': {\r\n                    ...defaultStylesBgEl,\r\n                    top: {\r\n                      xs: '',\r\n                      md: '376px',\r\n                      lg: '446px',\r\n                      xl: '551px',\r\n                    },\r\n                    bottom: { xs: '-22px' },\r\n                    left: {\r\n                      xs: '2px',\r\n                      md: '300px',\r\n                      lg: '397px',\r\n                      xl: '549px',\r\n                    },\r\n                    width: {\r\n                      xs: '36px',\r\n                      md: '40px',\r\n                      lg: '57px',\r\n                      xl: '82px',\r\n                    },\r\n                    height: {\r\n                      xs: '18px',\r\n                      md: '20px',\r\n                      lg: '41px',\r\n                      xl: '41px',\r\n                    },\r\n                    backgroundImage: `url(${twoTriangles})`,\r\n                  },\r\n                  '::after': {\r\n                    ...defaultStylesBgEl,\r\n                    top: { xs: '-35px', md: '350px', lg: '466px', xl: '580px' },\r\n                    left: { xs: '', md: '-351px', lg: '-502px', xl: '-725px' },\r\n                    right: { xs: '56px' },\r\n                    width: { xs: '13px', md: '11px', lg: '20px', xl: '20px' },\r\n                    height: { xs: '9px', md: '9px', lg: '14px', xl: '1